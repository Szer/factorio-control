  "components": {
    "schemas": {
      "AdminsDocument": {
        "type": "object",
        "required": [
          "revision",
          "admins"
        ],
        "properties": {
          "admins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "LogEntry": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "level",
          "message"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "level": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "LogLevel": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "error"
        ]
      },
      "Save": {
        "type": "object",
        "required": [
          "name",
          "size_bytes",
          "modified_at"
        ],
        "properties": {
          "modified_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ServerSettings": {
        "type": "object",
        "required": [
          "name",
          "description",
          "max_players",
          "auto_pause",
          "autosave_interval",
          "visibility"
        ],
        "properties": {
          "auto_pause": {
            "type": "boolean"
          },
          "autosave_interval": {
            "type": "integer",
            "format": "int32",
            "maximum": 1440,
            "minimum": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "max_players": {
            "type": "integer",
            "format": "int32",
            "maximum": 65535,
            "minimum": 0
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          }
        },
        "additionalProperties": false
      },
      "ServerState": {
        "type": "string",
        "enum": [
          "stopped",
          "starting",
          "running",
          "stopping",
          "failed"
        ]
      },
      "SettingsDocument": {
        "type": "object",
        "required": [
          "revision",
          "settings"
        ],
        "properties": {
          "revision": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/ServerSettings"
          }
        },
        "additionalProperties": false
      },
      "StartRequest": {
        "type": "object",
        "required": [
          "save"
        ],
        "properties": {
          "save": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Status": {
        "type": "object",
        "required": [
          "state",
          "active_save",
          "started_at",
          "binary_available",
          "version",
          "error"
        ],
        "properties": {
          "active_save": {
            "type": [
              "string",
              "null"
            ]
          },
          "binary_available": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/ServerState"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Visibility": {
        "type": "object",
        "required": [
          "public",
          "lan"
        ],
        "properties": {
          "lan": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
